{
  "name": "reelo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start -w @reelo/mobile",
    "admin": "npm run dev -w @reelo/admin",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint apps packages tests --max-warnings 0",
    "test": "vitest run",
    "test:static": "node --test tests/static.test.mjs",
    "build:admin": "npm run build -w @reelo/admin",
    "test:native": "jest --config jest.config.cjs --runInBand"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@eslint/js": "^9.39.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/node": "^22.18.0",
    "eslint": "^9.39.0",
    "expo-router": "~6.0.24",
    "jest": "^29.7.0",
    "react-test-renderer": "^19.1.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
