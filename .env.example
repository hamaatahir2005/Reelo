# Copy mobile values to apps/mobile/.env; admin values to apps/admin/.env.local
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Edge Function secrets only. NEVER put service role in an EXPO_PUBLIC/NEXT_PUBLIC variable.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_SCHEME=reelo-dev
APP_NAME=Reelo
ANDROID_PACKAGE=dev.placeholder.reelo
IOS_BUNDLE_ID=dev.placeholder.reelo
# raw-private supports original MP4 only; production HLS requires a real adapter
VIDEO_PROVIDER=raw-private
EXPO_ACCESS_TOKEN=
